# URL Web App Google Apps Script hasil Deploy ('Deploy as Web App')
# Format: https://script.google.com/macros/s/AKfycbx.../exec
APPSCRIPT_URL=https://script.google.com/macros/s/YOUR_APPSCRIPT_DEPLOYMENT_ID/exec

# Secret Key Otentikasi API (harus sama dengan nilai API_SECRET_TOKEN di Kode.gs Script Properties)
API_SECRET_TOKEN=dht_sec_99a8b7c6d5e4f3a2b1c0

